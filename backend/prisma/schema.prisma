generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String   // Hashed password
  avatarConfig String? // JSON string of avatar configuration
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id        String   @id
  state     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Puzzle {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  fen         String   // Starting position (FEN notation)
  sideToMove  String   // Solver side ("white" | "black")
  solutionPv  String   // JSON array of UCI moves: ["e2e4", "e7e5", ...]
  motifs      String   // JSON array of themes: ["mate", "fork", ...]
  source      String   // Origin: "lichess-puzzle:12345" or "manual"
  rating      Int?     // Difficulty rating (0-10000)
  
  @@index([createdAt])
}

model PuzzleAttempt {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  puzzleId  String
  timeMs    Int      // Time taken (milliseconds)
  mistakes  Int      // Incorrect attempts
  solved    Boolean  // Success flag
  rating    Int?     // Optional user rating
  
  puzzle    Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  
  @@index([puzzleId, createdAt])
}


