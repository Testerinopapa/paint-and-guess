generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String   // Hashed password
  avatarConfig String? // JSON string of avatar configuration
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Game ratings (ELO-based)
  chessRating      Int? @default(1500)
  triviaRating     Int? @default(1500)
  
  // Game results
  whiteChessGames  ChessGame[] @relation("WhiteGames")
  blackChessGames  ChessGame[] @relation("BlackGames")
  
  // Puzzle attempts
  puzzleAttempts   PuzzleAttempt[]
}

model Room {
  id        String   @id
  state     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Puzzle {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  fen         String
  sideToMove  String   // "white" | "black"
  solutionPv  String   // JSON array of UCI moves
  motifs      String   // JSON array of puzzle themes
  source      String
  rating      Int?

  attempts    PuzzleAttempt[]

  @@index([createdAt])
  @@index([rating])
}

model PuzzleCatalog {
  id        String   @id @default(cuid())
  ratingMin Int
  ratingMax Int
  motif     String  @default("all") // "all" = all motifs, otherwise specific motif
  puzzleIds String  // JSON array of valid puzzle IDs
  count     Int      // Number of puzzles in this catalog entry
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([ratingMin, ratingMax, motif])
  @@index([ratingMin, ratingMax, motif])
}

model PuzzleAttempt {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  puzzleId  String
  userId    String?  // Optional: null for anonymous attempts
  timeMs    Int
  mistakes  Int
  solved    Boolean
  rating    Int?

  puzzle    Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([puzzleId, createdAt])
  @@index([userId, solved])
  @@unique([userId, puzzleId, solved]) // Prevent duplicate solved records per user
}

model Report {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  pgn       String
  depth     Int
  elo       Int?
  fens      String   // JSON array of FEN strings
  sans      String   // JSON array of SAN moves
  evals     String   // JSON array of evaluation scores (centipawns)
  tags      String   // JSON array of move tags
  accuracy  Float

  @@index([createdAt])
}

model ChessGame {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  whiteUserId String?
  blackUserId String?
  result      String   // "1-0", "0-1", "1/2-1/2"
  pgn         String?
  whiteRatingBefore Int?
  blackRatingBefore Int?
  whiteRatingAfter  Int?
  blackRatingAfter  Int?
  whiteRatingChange Int?
  blackRatingChange Int?
  gameMode    String   // "local", "ai", "online"
  aiElo       Int?     // If playing against AI
  
  whiteUser   User?    @relation("WhiteGames", fields: [whiteUserId], references: [id], onDelete: SetNull)
  blackUser   User?    @relation("BlackGames", fields: [blackUserId], references: [id], onDelete: SetNull)
  
  @@index([whiteUserId, createdAt])
  @@index([blackUserId, createdAt])
  @@index([createdAt])
}

model TriviaGame {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  roomId      String
  quizId      String?
  quizName    String?
  totalQuestions Int
  players     String   // JSON array of player results: [{userId, name, score, finalRank, ratingBefore, ratingAfter, ratingChange}]
  
  @@index([createdAt])
}


