{
  "name": "paint-and-guess-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend server for Paint & Guess multiplayer game",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate --schema ./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema ./prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema ./prisma/schema.prisma",
    "prisma:db:push": "prisma db push --schema ./prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema ./prisma/schema.prisma",
    "test:puzzle-db": "node scripts/test-puzzle-db.js",
    "test:puzzle-validation": "node scripts/test-puzzle-validation.js",
    "test:puzzle-solutions": "node scripts/test-puzzle-solutions.js",
    "test:puzzle-position": "node scripts/test-puzzle-position-assignment.js",
    "test:puzzle-normalization": "node scripts/test-puzzle-normalization.js",
    "test:indexed-puzzles": "node scripts/test-indexed-puzzles.js",
    "validate:all-puzzles": "node scripts/validate-all-puzzles.js",
    "fix:puzzle-move-order": "node scripts/fix-puzzle-move-order.js",
    "normalize:puzzle-pv": "node scripts/normalize-puzzle-pv.js",
    "import:dev-db": "node scripts/import-dev-db.js",
    "import:lichess-zst": "node --max-old-space-size=4096 scripts/import-lichess-zst.js",
    "test:engine": "node scripts/test-engine.js",
    "download:stockfish": "node scripts/download-stockfish.js",
    "postinstall": "npm run download:stockfish || echo 'Stockfish download skipped (optional)'"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "@socket.io/redis-adapter": "^8.2.1",
    "better-sqlite3": "^11.7.0",
    "bcryptjs": "^3.0.3",
    "chessops": "^0.15.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "prisma": "^5.19.1"
  }
}
